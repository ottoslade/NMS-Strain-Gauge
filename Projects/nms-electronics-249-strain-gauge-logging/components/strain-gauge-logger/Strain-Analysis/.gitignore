# ---- Log data ----
# Strain-Logs/raw-sd-data/  .blf logs copied off the SD card or made by fake_blf.py
# Strain-Logs/CSV/          CSVs decoded by read_blf.py
# Strain-Logs/Strain/       microstrain CSVs from strain.py
# Strain-Logs/Plots/        PNGs from plot_strain.py
# Both are data, not code, and can be large. Keep the folders, not the files.
Strain-Logs/raw-sd-data/*
!Strain-Logs/raw-sd-data/.gitkeep
Strain-Logs/CSV/*
!Strain-Logs/CSV/.gitkeep
Strain-Logs/Strain/*
!Strain-Logs/Strain/.gitkeep
Strain-Logs/Plots/*
!Strain-Logs/Plots/.gitkeep
# Anything else dropped straight into Strain-Logs/
Strain-Logs/*.blf
Strain-Logs/*.csv
# To commit a specific log anyway: git add -f Strain-Logs/raw-sd-data/<file>

# ---- Build output ----
# check_blf.py compiles this on first run
fw_check/fw_writer
fw_check/fw_writer.exe
*.o
*.obj

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
