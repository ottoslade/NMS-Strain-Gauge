# ---- Log data ----
# strain_logs/1_raw_blf/       .blf logs copied off the SD card or made by fake_blf.py
# strain_logs/1_raw_gps/       GPS track CSVs (real, or made by fake_gps.py)
# strain_logs/2_voltage_csv/    volts per gauge, decoded by read_blf.py
# strain_logs/3_voltage_plots/  voltage PNGs from pipeline.py / plot_strain.py --volts
# strain_logs/4_strain_csv/     microstrain per gauge, from strain.py
# strain_logs/5_strain_plots/   strain PNGs from pipeline.py / plot_strain.py
# strain_logs/6_strain_gps_csv/ strain (or volts) plus GPS position per sample, from gps.py
# strain_logs/7_strain_maps/    track maps coloured by strain, from gps.py / pipeline.py
# strain_logs/8_reports/        one interactive page per log (all plots, in tabs), from pipeline.py
# All of these are data, not code, and can be large. Keep the folders, not the files.
strain_logs/1_raw_blf/*
!strain_logs/1_raw_blf/.gitkeep
strain_logs/1_raw_gps/*
!strain_logs/1_raw_gps/.gitkeep
strain_logs/2_voltage_csv/*
!strain_logs/2_voltage_csv/.gitkeep
strain_logs/3_voltage_plots/*
!strain_logs/3_voltage_plots/.gitkeep
strain_logs/4_strain_csv/*
!strain_logs/4_strain_csv/.gitkeep
strain_logs/5_strain_plots/*
!strain_logs/5_strain_plots/.gitkeep
strain_logs/6_strain_gps_csv/*
!strain_logs/6_strain_gps_csv/.gitkeep
strain_logs/7_strain_maps/*
!strain_logs/7_strain_maps/.gitkeep
strain_logs/8_reports/*
!strain_logs/8_reports/.gitkeep
# Anything else dropped straight into strain_logs/
strain_logs/*.blf
strain_logs/*.csv
strain_logs/*.png
# To commit a specific log anyway: git add -f strain_logs/1_raw_blf/<file>

# ---- Build output ----
# check_blf.py compiles this on first run
fw_check/fw_writer
fw_check/fw_writer.exe
*.o
*.obj

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
