#Ignore all jetbrain product directories
**/.idea/
*.lck
# Ignore all build directories
**/build/

# Ignore all .vscode directories
**/.vscode/

# Ignore all .idea directories
**/.idea/

################################################################################
# stm32forvscode
################################################################################

# Ignore all STM32Make.make files
**/STM32Make.make

# Ignore all .mxproject files
**/.mxproject

# Ignore all .stm32env files
**/.stm32env

**/STM32-for-VSCode.config.yaml

**/openocd.cfg

################################################################################
# esp-idf
################################################################################

# Ignore all sdkconfig.* files
**/sdkconfig.*

# Keep sdkconfig.rename file contained in esp-idf
!**/esp-idf-v*/sdkconfig.rename

################################################################################
# kicad
################################################################################

# temp files
**/hardware/**/*.000
**/hardware/**/*.bak
**/hardware/**/*.bck
**/hardware/**/*.kicad_pcb-bak
**/hardware/**/*.kicad_sch-bak
**/hardware/**/*-backups
**/hardware/**/*.kicad_prl
**/hardware/**/*.sch-bak
**/hardware/**/*~
**/hardware/**/_autosave-*
**/hardware/**/*.tmp
**/hardware/**/*-save.pro
**/hardware/**/*-save.kicad_pcb
**/hardware/**/fp-info-cache
**/hardware/**/\#auto_saved_files\#

# netlist files
**/hardware/**/*.net

# autorouter files
**/hardware/**/*.dsn
**/hardware/**/*.ses

# exported BOMs
**/hardware/**/*.xml
**/hardware/**/*.csv

################################################################################
# macOS
################################################################################

.DS_Store
.AppleDouble
.LSOverride
Icon^M
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

################################################################################
# Windows
################################################################################

# thumbnail cache
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# folder config
[Dd]esktop.ini

# shortcuts
*.lnk

# installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# other
*.stackdump
$RECYCLE.BIN/

hv-electronics/hv-bms/hardware/segment-pcb/~Segment PCB.kicad_sch.lck
hv-electronics/hv-bms/hardware/segment-pcb/~Segment PCB.kicad_pcb.lck
